<?xml version="1.0" encoding="utf-8"?>
<!--
  The narrowest configuration that does the job.

  Only window state changes are requested, and only from the Amazon launcher.
  No view content, no text, no keystrokes. The service cannot read anything the
  user types or sees, and nothing it observes leaves the TV.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:packageNames="com.amazon.tv.launcher"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:description="@string/watcher_description" />
